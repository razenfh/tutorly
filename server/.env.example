# Скопируйте в /etc/zhurnal-board.env и впишите свой ключ (openssl rand -base64 24)
ADMIN_TOKEN=замените-на-длинный-случайный-ключ
PORT=8080
HOST=127.0.0.1
# 1, если сервер стоит за Caddy (по инструкции). Нужно, чтобы защита от перебора ссылок считала адреса настоящих посетителей
TRUST_PROXY=1
DATA_DIR=/opt/zhurnal-board/data
# Если задать, регистрироваться учителем можно только с этим кодом (ученики и родители регистрируются свободно)
# TEACHER_INVITE=придумайте-код
