[Unit]
Description=Сервер совместной доски (журнал репетитора)
After=network.target

[Service]
User=zhurnal
WorkingDirectory=/opt/zhurnal-board
EnvironmentFile=/etc/zhurnal-board.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/zhurnal-board/data

[Install]
WantedBy=multi-user.target
