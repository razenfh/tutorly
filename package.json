{
  "name": "tutorly",
  "productName": "Tutorly",
  "version": "0.1.0",
  "description": "Расписание уроков, оплата, переносы с причинами и домашние задания для репетитора",
  "main": "main.js",
  "desktopName": "tutorly.desktop",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "app.tutor.journal",
    "productName": "Tutorly",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  }
}
