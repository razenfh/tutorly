#!/bin/sh
# Запуск Tutorly на системном Electron.
# Свои флаги Electron можно положить в ~/.config/tutorly-flags.conf (по одному в строке).
flags_file="${XDG_CONFIG_HOME:-$HOME/.config}/tutorly-flags.conf"
if [ -r "$flags_file" ]; then
  # shellcheck disable=SC2046
  set -- $(grep -v '^[[:space:]]*#' "$flags_file" | tr '\n' ' ') "$@"
fi
exec electron /usr/lib/tutorly --ozone-platform-hint=auto "$@"
